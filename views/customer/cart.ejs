<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>The Readers Shelf</title>
    <link rel="stylesheet" href="/bootstrap.min.css">
</head>
<body>
<nav class="navbar bg-dark border-bottom border-body" data-bs-theme="dark">
    <div class="container">
        <a class="navbar-brand" href="/customer/books">The Readers Shelf</a>
        <div class="col-4 d-flex justify-content-end align-items-center">
            <a class="btn btn-outline-light" href="/customer/cart">Cart</a>
        </div>
    </div>
</nav>
<div class="container mb-5">
    <div class="my-5">
        <h2 class="text-center">Cart</h2>
    </div>

    <div class="d-flex flex-column justify-content-center align-items-center">
        <div class="col-12 w-75 mb-2 d-flex justify-content-end">
            <a class="btn btn-outline-primary" href="/customer/books">Continue shopping</a>
        </div>
        <%for (const book of books) {%>
            <div class="card mb-3 card w-75" style="height: 210px">
                <div class="row g-0">
                    <div class="col-md-2">
                        <img style="height: 200px; object-fit: fill" src="<%=book.cover%>" class="card-img-top img-fluid" alt="<%=book.title%> Cover Image">
                    </div>
                    <div class="col-md-10">
                        <div class="card-body">
                            <h4 class="card-title"><%=book.title%></h4>
                            <h6 class="card-subtitle mb-2 text-success"><%=book.author%></h6>
                            <div class="my-3 d-flex justify-content-between align-items-center">
                                <div class="col-4">
                                    <h4 class="text-primary"><%=book.price%></h4>
                                </div>
                                <div class="col-2">
                                    <div class="col-12 d-flex justify-content-between align-items-end" style="width:100px">
                                        <form action="/customer/cart/<%=book.id%>?_method=delete" method="post">
                                            <button class="btn btn-dark d-flex align-items-center" style="width: 35px; height: 35px" type="submit">-</button>
                                        </form>
                                        <div>
                                            <h4><%=book.cart_quantity%></h4>
                                        </div>
                                        <form action="/customer/cart/<%=book.id%>" method="post">
                                            <button class="btn btn-dark d-flex align-items-center" style="width: 35px; height: 35px" type="submit">+</button>
                                        </form>
                                    </div>
                                    <div class="col-12 d-flex justify-content-start align-items-end my-2">
                                        <p><%=book.stock_quantity%> left in stock</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <%}%>
    </div>
</div>
<script src="/bootstrap.bundle.min.js"></script>
</body>
</html>
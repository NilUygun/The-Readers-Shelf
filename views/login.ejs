<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>The Readers Shelf</title>
    <link rel="stylesheet" href="/bootstrap.min.css">
</head>
<body>
<nav class="navbar bg-dark border-bottom border-body" data-bs-theme="dark">
    <div class="container">
        <a class="navbar-brand" href="/customer/books">The Readers Shelf</a>
        <div class="col-4 d-flex justify-content-end align-items-center">
            <a class="btn btn-outline-light" href="/customer/cart">Cart</a>
        </div>
    </div>
</nav>
<div class="container">
    <div class="my-5">
        <h2 class="text-center">Login</h2>
    </div>
    <% if (messages.error) { %>
        <%= messages.error %>
    <% } %>
    <form action="/login" method="post">
        <div class="d-flex justify-content-center">
            <div class="col-4 mb-2">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" required>
            </div>
        </div>
        <div class="d-flex justify-content-center">
            <div class="col-4 mb-2">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" id="password" name="password" required>
            </div>
        </div>
        <div class="d-flex justify-content-center">
            <div class="col-4 mt-3">
                <button type="submit" class="w-100 btn btn-success">Login</button>
                <div class="mt-3">
                    <label for="register" class="form-label">Don't have an account?</label>
                    <a href="/register" id="register" class="w-100 btn btn-success">Register</a>
                </div>
            </div>
        </div>
    </form>
</div>
<script src="/bootstrap.bundle.min.js"></script>
</body>
</html>